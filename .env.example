# The main custom SIM-backed OTP flow uses a pepper managed in Supabase Vault.
# Never put privileged credentials, OTP secrets, or session tokens in browser/native config.
# Optional: only required if you independently wire Supabase Auth's Send SMS Hook:
SEND_SMS_HOOK_SECRET=optional-legacy-hook-secret
# Optional invite base URL. Default comes from server-calls source configuration.
SERVER_GUEST_BASE_URL=https://your-https-host/guest.html
# Optional only after a TURN relay is actually deployed:
# SERVER_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# SERVER_TURN_SHARED_SECRET=replace-with-your-coturn-secret
