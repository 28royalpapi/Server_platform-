# Configure these in Supabase Edge Function secrets, never browser JavaScript.
# Required for Authentication -> Hooks -> Send SMS Hook signature validation:
SEND_SMS_HOOK_SECRET=replace-with-a-strong-standard-webhooks-secret
# Optional site origin/CORS restriction if the edge functions are configured for it:
SERVER_GUEST_BASE_URL=https://your-https-server-web-host/guest.html
# Optional only if a TURN relay is provisioned; STUN is the default:
# SERVER_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# SERVER_TURN_SHARED_SECRET=replace-with-your-coturn-static-auth-secret
