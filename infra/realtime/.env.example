# Copy to .env. Generate each value independently with a cryptographically secure
# random generator. Never commit .env or expose these values to browser/mobile clients.
REALTIME_HOST=realtime.example.com
REDIS_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_BASE64URL_OR_HEX_SECRET
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CENTRIFUGO_HTTP_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# Optional self-hosted TURN relay. Use the VM public IPv4; for 1:1 NAT,
# set PUBLIC/PRIVATE (for example 203.0.113.10/10.0.0.10).
SERVER_TURN_EXTERNAL_IP=REPLACE_WITH_PUBLIC_IPV4
SERVER_TURN_SHARED_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET

# Optional self-hosted Coturn relay (required for reliable calls across
# restrictive mobile/carrier NATs). Used by docker-compose.turn.yml.
TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=203.0.113.10
SERVER_TURN_SHARED_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
